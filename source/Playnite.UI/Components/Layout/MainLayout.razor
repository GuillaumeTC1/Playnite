@inherits LayoutComponentBase
@* @inject PlayniteStateService StateService *@

<div class="main-layout @* @GetLayoutClass() *@">
    <header class="main-header">
        <nav>
            <NavMenu />
        </nav>
    </header>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" @* class="@GetErrorUiClass()" *@>
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
